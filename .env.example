# ==============================================================================
# LA MENTE DEL GUERRERO / THE WARRIOR'S MIND
# Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
# In development: http://localhost:3000
# In production: https://tudominio.com (or Vercel domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (Database, Auth & Realtime)
# Found at: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
# Required for backend server actions/webhooks (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada

# ------------------------------------------------------------------------------
# 3. PAYPAL (Primary Payment Processor)
# ------------------------------------------------------------------------------
# Link direct payment (PayPal Payment Link, PayPal Checkout URL or PayPal.me)
# Generated from PayPal -> Pay & Get Paid -> PayPal Buttons / Payment Links
# Example: https://www.paypal.com/ncp/payment/ABC123XYZ or https://paypal.me/TuCuenta/47USD
NEXT_PUBLIC_PAYPAL_CHECKOUT_URL=https://www.paypal.com/ncp/payment/TU_LINK_DE_PAGO_AQUI

# ------------------------------------------------------------------------------
# 4. OPTIONAL / BACKUP PROCESSORS (If you enable them in the future)
# ------------------------------------------------------------------------------
# Stripe (Optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Lemon Squeezy (Optional)
# NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://...
# LEMON_SQUEEZY_WEBHOOK_SECRET=...
